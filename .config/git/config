[user]
	name = Sergio Hernández Gutiérrez
	email = contact.sergiohernandez@gmail.com
[init]
	defaultBranch = main
[core]
	editor = nvim
	excludesfile = ~/.config/git/.gitignore_global
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    pager = most
[push]
    autoSetupRemote = true
[diff]
	tool = codediff
[difftool]
    prompt = false
[gitflow "prefix"]
    versiontag = v
[color]
	ui = auto
[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold
[alias]
    a = add --all
	b = branch
    C = clone
	c = commit -m
    d = diff
    m = merge
    o = checkout
    O = checkout -b
	p = pull
    P = push
	r = rebase
    R = reset
    S = stash
    s = status
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[pull]
	rebase = true
[merge]
	tool = codediff
[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff merge \\\"$MERGED\\\"\"
[difftool "codediff"]
	cmd = nvim \"$LOCAL\" \"$REMOTE\" +\"CodeDiff file $LOCAL $REMOTE\"
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
