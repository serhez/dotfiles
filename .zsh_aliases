# ssh and remote work

# sshgpu [galvani|ferranti] [node_name]
sshgpu()
{
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: sshgpu [galvani|ferranti] [node_name]"
        return 1
    fi

    local ip
    if [ "$1" = "galvani" ]; then
        ip="134.2.168.43"
    elif [ "$1" = "ferranti" ]; then
        ip="134.2.168.202"
    else
        echo "Invalid argument: $1"
        echo "Usage: sshgpu [galvani|ferranti] [node_name]"
        return 1
    fi

    local node_name="$2"

    ssh -L 5678:"$node_name":5678 bkr361@"$ip"
    if [ $? -ne 0 ]; then
        echo "Failed to connect to $1 GPU node $node_name"
        echo "Usage: sshgpu [galvani|ferranti] [node_name]"
        echo "Note that you need to have an active debugpy session on the cluster first on port 5678."
        echo "You can use the command 'python -m debugpy --listen 0.0.0.0:5678 --wait-for-client your_script.py'"
        return 1
    fi
}

# mounting
# Slow network flags: -o port=2221,auto_cache,defer_permissions,noappledouble,no_readahead,cache=yes,cache_timeout=115200,attr_timeout=115200,entry_timeout=1200,negative_timeout=1200,slow_statfs,iosize=16384

# mnt [galvani|ferranti] [path_from_home]
mnt()
{
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: mnt [galvani|ferranti] [path_from_home]"
        return 1
    fi

    local ip
    if [ "$1" = "galvani" ]; then
        ip="134.2.168.43"
    elif [ "$1" = "ferranti" ]; then
        ip="134.2.168.202"
    else
        echo "Invalid argument: $1"
        echo "Usage: mnt [galvani|ferranti] [path_from_home]"
        return 1
    fi

    # Create mount point if it does not exist
    mkdir -p $HOME/mnt/"$1"/"$2"

    # Mount the remote directory using sshfs
    sshfs -o port=2221 bkr361@"$ip":"$2" $HOME/mnt/"$1"/"$2"
    if [ $? -ne 0 ]; then
        echo "Failed to mount $1:$2"
        return 1
    fi
}

# unmnt [galvani|ferranti] [path_from_home]
unmnt()
{
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: unmnt [galvani|ferranti] [path_from_home]"
        return 1
    fi

    # Unmount the remote directory using diskutil
    diskutil umount force $HOME/mnt/"$1"/"$2"
    if [ $? -ne 0 ]; then
        echo "Failed to unmount $1:$2"
        return 1
    fi
}

# nvim
alias v='nvim'
alias vd='nvim -d'
alias vv='neovide --no-tabs --title-hidden' # vv(isual)
alias vui='neovide --no-tabs --title-hidden' # v(ui)
alias vslow='nvim -c "let g:slow_network = 1"'

# vr [host] [--storage|-s home|work] [--dir|-d path_from_storage]
vr()
{
    local host=""
    local storage="home"
    local dir=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --storage|-s)
                storage="$2"
                shift 2
                ;;
            --dir|-d)
                dir="$2"
                shift 2
                ;;
            *)
                if [ -z "$host" ]; then
                    host="$1"
                    shift
                else
                    echo "Unknown argument: $1"
                    echo "Usage: vr [host] [--storage|-s home|work] [--dir|-d path_from_storage]"
                    return 1
                fi
                ;;
        esac
    done

    if [ -z "$host" ]; then
        echo "Usage: vr [host] [--storage|-s home|work] [--dir|-d path_from_storage]"
        return 1
    fi

    local base_path
    if [ "$storage" = "home" ]; then
        base_path="/home/bethge/bkr361"
    elif [ "$storage" = "work" ] && [ "$host" = "galvani" ] || [ "$host" = "galvani2" ]; then
        base_path="/mnt/lustre/work/bethge/bkr361"
    elif [ "$storage" = "work" ] && [ "$host" = "ferranti" ] || [ "$host" = "ferranti2" ]; then
        echo "Invalid storage: $storage"
        echo "Ferranti does not have a work directory"
        return 1
    else
        echo "Invalid storage: $storage"
        echo "Usage: vr [host] [--storage|-s home|work] [--dir|-d path_from_storage]"
        return 1
    fi

    # Open the remote directory in nvim using oil
    if [ -z "$dir" ]; then
        # nvim oil-ssh://"$host"/"$base_path"/
        nvim canola-ssh://"$host"/"$base_path"/
    else
        # nvim oil-ssh://"$host"/"$base_path"/"$dir"/.  # we add a dot as a workaround hack; otherwise, it opens the parent directory
        nvim canola-ssh://"$host"/"$base_path"/"$dir"/.  # we add a dot as a workaround hack; otherwise, it opens the parent directory
    fi
    if [ $? -ne 0 ]; then
        echo "Failed to open neovim at $host:$storage/$dir"
        return 1
    fi
}

# vR [host] [--storage|-s home|work] --dir|-d path_from_storage
# Personal cluster shortcut for the public editr binary.
vR()
{
    local host=""
    local storage="home"
    local dir=""
    local local_root="$HOME/remote"
    local local_path_override=""
    local session_name_override=""
    local allow_root=0
    local -a editr_args

    while [[ $# -gt 0 ]]; do
        case $1 in
            --storage|-s)
                storage="$2"
                shift 2
                ;;
            --dir|-d)
                dir="$2"
                shift 2
                ;;
            --local-root|-L)
                local_root="$2"
                shift 2
                ;;
            --local-path)
                local_path_override="$2"
                shift 2
                ;;
            --session-name)
                session_name_override="$2"
                shift 2
                ;;
            --root|--allow-root)
                allow_root=1
                shift
                ;;
            --config|-C|--ignore|-i|--mode|-m|--editor|-e)
                editr_args+=("$1" "$2")
                shift 2
                ;;
            --allow-nonempty|--no-bootstrap|--create-remote|--sync-vcs|--ignore-vcs|--keep-session|--dry-run)
                editr_args+=("$1")
                shift
                ;;
            --help|-h)
                echo "Usage: vR [host] [--storage|-s home|work] --dir|-d path_from_storage [editr options]"
                echo "Examples:"
                echo "  vR ferranti2 -d dev/value-bench"
                echo "  vR galvani2 -s work -d project --ignore runs/"
                return 0
                ;;
            --)
                shift
                editr_args+=("$@")
                break
                ;;
            -*)
                editr_args+=("$1")
                shift
                ;;
            *)
                if [ -z "$host" ]; then
                    host="$1"
                    shift
                else
                    echo "Unexpected positional argument: $1"
                    echo "Usage: vR [host] [--storage|-s home|work] --dir|-d path_from_storage [editr options]"
                    return 1
                fi
                ;;
        esac
    done

    if [ -z "$host" ]; then
        echo "Usage: vR [host] [--storage|-s home|work] --dir|-d path_from_storage [editr options]"
        return 1
    fi

    while [[ "$dir" == */ && "$dir" != "/" ]]; do
        dir="${dir%/}"
    done

    if [ -z "$dir" ] && [ "$allow_root" -ne 1 ]; then
        echo "Refusing to sync the entire $storage root. Pass --dir, or pass --allow-root intentionally."
        return 1
    fi

    if [[ "$dir" == /* || "$dir" == ".." || "$dir" == ../* || "$dir" == */../* || "$dir" == */.. ]]; then
        echo "--dir must be a relative path inside the selected storage root"
        return 1
    fi

    local host_name="${host##*@}"
    local base_path
    if [ "$storage" = "home" ]; then
        base_path="/home/bethge/bkr361"
    elif [[ "$storage" = "work" && ( "$host_name" = "galvani" || "$host_name" = "galvani2" ) ]]; then
        base_path="/mnt/lustre/work/bethge/bkr361"
    elif [[ "$storage" = "work" && ( "$host_name" = "ferranti" || "$host_name" = "ferranti2" ) ]]; then
        echo "Invalid storage: $storage"
        echo "Ferranti does not have a work directory"
        return 1
    else
        echo "Invalid storage: $storage"
        echo "Usage: vR [host] [--storage|-s home|work] --dir|-d path_from_storage [editr options]"
        return 1
    fi

    local remote_path="$base_path"
    local_root="${local_root/#\~/$HOME}"
    local local_path="$local_root/$host/$storage"
    if [ -n "$dir" ]; then
        remote_path="${base_path%/}/${dir#/}"
        local_path="$local_path/${dir#/}"
    fi

    local safe_host="${host//@/-}"
    safe_host="${safe_host//:/-}"
    safe_host="${safe_host//\//-}"
    local safe_dir="${dir:-root}"
    safe_dir="${safe_dir//\//-}"
    safe_dir="${safe_dir//:/-}"
    safe_dir="${safe_dir// /_}"
    local session_name="editr-${safe_host}-${storage}-${safe_dir}"
    [[ -n "$local_path_override" ]] && local_path="$local_path_override"
    [[ -n "$session_name_override" ]] && session_name="$session_name_override"

    if [[ "$OSTYPE" == darwin* ]]; then
        local agent_env="$HOME/.ssh/agent/env"
        if [[ ( -z "${SSH_AUTH_SOCK:-}" || ! -S "$SSH_AUTH_SOCK" ) && -r "$agent_env" ]]; then
            source "$agent_env" >/dev/null
        fi
        if ! ssh-add -l >/dev/null 2>&1; then
            [[ -r "$agent_env" ]] && source "$agent_env" >/dev/null
            ssh-add --apple-load-keychain -q >/dev/null 2>&1 || true
        fi
    fi

    command editr \
        "$host:$remote_path" \
        --local-path "$local_path" \
        --session-name "$session_name" \
        "${editr_args[@]}"
}

